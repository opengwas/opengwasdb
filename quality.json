{
  "project": "opengwasdb",
  "base_ref": "origin/main",
  "doc_size": [
    {
      "file": "CLAUDE.md",
      "ceiling": 750
    },
    {
      "file": "README.md",
      "ceiling": 350
    }
  ],
  "escapes": {
    "roots": [
      "."
    ],
    "languages": [
      "python",
      "shell"
    ],
    "skip_dirs": [
      "quality",
      ".claude",
      ".pixi"
    ],
    "baseline": "quality/escapes-baseline.json"
  },
  "duplication": {
    "roots": [
      "."
    ],
    "languages": [
      "python",
      "shell"
    ],
    "skip_dirs": [
      "quality",
      ".claude",
      ".pixi"
    ],
    "min_lines": 6,
    "baseline": "quality/duplication-baseline.json"
  },
  "hygiene": {
    "roots": [
      "docs/spec",
      "tests"
    ],
    "skip_dirs": [],
    "extensions": [
      ".bash",
      ".py",
      ".sh",
      ".zsh"
    ],
    "habits": {
      "fixed sleeps": {
        "pattern": "(?:time\\.sleep\\()|(?:\\bsleep\\s+[0-9])",
        "ceiling": 0,
        "use": "wait for the condition, not the clock"
      }
    }
  },
  "complexity": {
    "tool": "lizard",
    "sources": [
      "."
    ],
    "languages": [
      "python"
    ],
    "exclude": [
      "*/.build/*",
      "*/.claude/*",
      "*/.git/*",
      "*/.github/*",
      "*/.idea/*",
      "*/.next/*",
      "*/.venv/*",
      "*/.vscode/*",
      "*/DerivedData/*",
      "*/Pods/*",
      "*/__pycache__/*",
      "*/benchmarks/*",
      "*/build/*",
      "*/coverage/*",
      "*/dist/*",
      "*/fixtures/*",
      "*/node_modules/*",
      "*/out/*",
      "*/quality/*",
      "*/target/*",
      "*/tests/*",
      "*/vendor/*",
      "*/venv/*",
      "*/opengwasdb/ld/*"
    ],
    "ceilings": {
      "cc": 8,
      "lines": 60
    },
    "baseline": "quality/complexity-baseline.json"
  },
  "gates": [
    {
      "name": "complexity:ld",
      "check": "complexity",
      "with": {
        "tool": "lizard",
        "sources": [
          "opengwasdb/ld"
        ],
        "languages": [
          "python"
        ],
        "exclude": [
          "*/.build/*",
          "*/.claude/*",
          "*/.git/*",
          "*/.github/*",
          "*/.idea/*",
          "*/.next/*",
          "*/.venv/*",
          "*/.vscode/*",
          "*/DerivedData/*",
          "*/Pods/*",
          "*/__pycache__/*",
          "*/benchmarks/*",
          "*/coverage/*",
          "*/dist/*",
          "*/fixtures/*",
          "*/node_modules/*",
          "*/out/*",
          "*/quality/*",
          "*/target/*",
          "*/vendor/*",
          "*/venv/*"
        ],
        "ceilings": {
          "cc": 8,
          "lines": 60
        },
        "baseline": "quality/complexity-ld-baseline.json"
      }
    }
  ],
  "conventions": {
    "rules": [
      {
        "name": "zero-filled unstored pair",
        "pattern": "\\b(?:nan_to_num|fillna|zeros_like)\\b|\\b(?:np|numpy)\\.zeros\\(|\\b(?:np|numpy)\\.full(?:_like)?\\(.*,\\s*-?0(?:\\.0*)?\\s*\\)(?!\\s*,)|\\.fill\\(\\s*-?0(?:\\.0*)?\\s*\\)|is(?:nan|finite)\\([^)]*\\)\\]\\s*=\\s*-?[\\d.]|\\b(?:np|numpy)\\.where\\(\\s*~?\\s*(?:(?:np|numpy)\\.)?is(?:nan|finite)\\([^)]*\\)\\s*,\\s*(?:-?[\\d.]+\\s*,|[^,]+,\\s*-?[\\d.]+\\s*\\))",
        "roots": [
          "opengwasdb/ld/query"
        ],
        "extensions": [
          ".py"
        ],
        "message": "An unstored pair is NaN, and only the caller's `fill` replaces it (spec \u00a78). Allocate a matrix with np.full(shape, np.nan) and apply `fill` in one place."
      },
      {
        "name": "zero-filled read",
        "pattern": "\\b(?:nan_to_num|fillna|zeros_like)\\b|\\b(?:np|numpy)\\.zeros\\(|\\b(?:np|numpy)\\.full(?:_like)?\\(.*,\\s*-?0(?:\\.0*)?\\s*\\)(?!\\s*,)|\\.fill\\(\\s*-?0(?:\\.0*)?\\s*\\)|is(?:nan|finite)\\([^)]*\\)\\]\\s*=\\s*-?[\\d.]|\\b(?:np|numpy)\\.where\\(\\s*~?\\s*(?:(?:np|numpy)\\.)?is(?:nan|finite)\\([^)]*\\)\\s*,\\s*(?:-?[\\d.]+\\s*,|[^,]+,\\s*-?[\\d.]+\\s*\\))",
        "roots": [
          "opengwasdb/ld/store"
        ],
        "extensions": [
          ".py"
        ],
        "message": "The reader reports an unstored pair as NaN (spec \u00a78): allocate with np.full(shape, np.nan) and build indptr arrays with np.concatenate/np.cumsum. A number in a NaN's place here reaches every query."
      },
      {
        "name": "int16 cast outside ogld.format",
        "pattern": "\\b(?:np|numpy)\\.int16\\b(?!\\s*\\])|['\\\"][<>=|]?(?:int16|i2)['\\\"]|\\b(?:astype|view)\\(\\s*(?:int16|i2)\\b|\\bdtype\\s*=\\s*(?:int16|i2)\\b|\\bfrom\\s+numpy\\s+import\\b.*\\bint16\\b",
        "roots": [
          "opengwasdb/ld"
        ],
        "extensions": [
          ".py"
        ],
        "exclude": [
          "*/opengwasdb/ld/format/*"
        ],
        "message": "Codes are made by opengwasdb.ld.format.quantise, and an r array's dtype is opengwasdb.ld.format.ENCODING's r_dtype: one place rounds half to even, never writes -32768 and refuses a value that is not a correlation (spec \u00a73)."
      },
      {
        "name": "the r scale outside ogld.format",
        "pattern": "\\b3276[78]\\b",
        "roots": [
          "opengwasdb/ld"
        ],
        "extensions": [
          ".py"
        ],
        "exclude": [
          "*/opengwasdb/ld/format/*"
        ],
        "message": "Use opengwasdb.ld.format's R_SCALE, RESERVED_CODE, quantise and dequantise; a second copy of the scale is a second encoding (spec \u00a73)."
      },
      {
        "name": "t_far recomputed",
        "pattern": "\\b20\\.84\\b",
        "roots": [
          "opengwasdb/ld"
        ],
        "extensions": [
          ".py"
        ],
        "exclude": [
          "*/opengwasdb/ld/format/*"
        ],
        "message": "A store records its t_far and every reader uses that record (spec \u00a73); a build calls opengwasdb.ld.format.t_far."
      },
      {
        "name": "a distance hard-coded",
        "pattern": "\\b(?:3_?000_?000|10_?000_?000)\\b",
        "roots": [
          "opengwasdb/ld"
        ],
        "extensions": [
          ".py"
        ],
        "exclude": [
          "*/opengwasdb/ld/format/*"
        ],
        "message": "Use the distances the store recorded, near_bp and far_bp (spec \u00a77), or opengwasdb.ld.format.NEAR_BP and FAR_BP for a build's defaults."
      },
      {
        "name": "print in the package",
        "pattern": "^\\s*print\\(",
        "roots": [
          "opengwasdb/ld"
        ],
        "extensions": [
          ".py"
        ],
        "exclude": [
          "*/opengwasdb/ld/cli/*"
        ],
        "message": "Only opengwasdb.ld.cli writes to the terminal. Return the value, or raise with the variant and the panel named."
      }
    ],
    "baseline": "quality/conventions-ld-baseline.json"
  },
  "public_api": [
    {
      "name": "ld",
      "language": "python",
      "roots": [
        "opengwasdb/ld"
      ],
      "baseline": "quality/public-api-ld.json"
    }
  ],
